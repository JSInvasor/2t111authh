# Production .env for 2t1auth  ->  copy to /opt/2t1auth/.env and fill in.
# Generate secrets ON THE VPS with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
# Bind to localhost only — nginx is the public entry point.
HOST=127.0.0.1

# Public URL (used for loader URLs, cookies, CORS-safety). MUST be https.
BASE_URL=https://2t1.online

# Long random secrets — DO NOT reuse the development ones. Generate fresh.
ADMIN_API_KEY=PASTE_A_64_CHAR_RANDOM_HEX_HERE
SESSION_SECRET=PASTE_ANOTHER_64_CHAR_RANDOM_HEX_HERE

KEY_PREFIX=2t1

# Absolute DB path so it works regardless of the service working directory.
DB_PATH=/opt/2t1auth/data/2t1auth.db

AUTH_RATE_MAX=30
AUTH_RATE_WINDOW_MS=60000

# Comma-separated executor names to reject at /api/v1/auth (case-insensitive).
BLOCKED_EXECUTORS=
ALLOWED_EXECUTORS=

# ---- Anti-tamper ----
ANTI_TAMPER=1
NONCE_TTL_MS=20000
KEY_SHARE_MAX_HWIDS=0
KEY_SHARE_WINDOW_MS=3600000

# ---- Discord bot (optional — leave empty to not run the bot) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_SCRIPT_ID=
DISCORD_WHITELIST_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_KEY_EXPIRES_DAYS=
