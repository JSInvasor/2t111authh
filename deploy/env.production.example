# Production .env for 2t1auth  ->  copy to /opt/2t1auth/.env and fill in.
# Generate secrets ON THE VPS with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
# Bind to localhost only — nginx is the public entry point.
HOST=127.0.0.1

# Public URL (used for loader URLs, cookies, CORS-safety). MUST be https.
BASE_URL=https://2t1.online

# Long random secrets — DO NOT reuse the development ones. Generate fresh.
ADMIN_API_KEY=PASTE_A_64_CHAR_RANDOM_HEX_HERE
SESSION_SECRET=PASTE_ANOTHER_64_CHAR_RANDOM_HEX_HERE

KEY_PREFIX=2t1

# Absolute DB path so it works regardless of the service working directory.
DB_PATH=/opt/2t1auth/data/2t1auth.db

AUTH_RATE_MAX=30
AUTH_RATE_WINDOW_MS=60000

# Number of reverse proxies in front of the app. nginx only = 1.
# Set to 0 if clients can reach the app directly, otherwise anyone can forge
# X-Forwarded-For and bypass both rate limiting and the handshake IP binding.
TRUST_PROXY=1

# Comma-separated executor names to reject at /api/v1/auth (case-insensitive).
BLOCKED_EXECUTORS=
ALLOWED_EXECUTORS=

# ---- Anti-tamper ----
# Master switch. 0 disables the handshake, the session proof and session-keyed
# delivery all at once — debug only, and the app refuses to boot with it in prod.
ANTI_TAMPER=1

# Handshake lifetime and binding.
NONCE_TTL_MS=20000
NONCE_BIND_IP=1
NONCE_MAX=50000
NONCE_MAX_PER_IP=60

# Require the loader's HMAC proof, and derive the payload key from the session
# instead of shipping it inside the payload. Leave both on.
REQUIRE_PROOF=1
SESSION_ENCRYPTION=1

# Serve /loader/<id>.lua as a per-request encrypted stub.
OBFUSCATE_LOADER=1

# Client-side tamper reports: log them (1), and optionally auto-ban a key after
# N reports in KEY_SHARE_WINDOW_MS (0 = never — reports are forgeable).
TAMPER_REPORTS=1
TAMPER_REPORT_BAN=0

# Key sharing: auto-ban a key seen from more than N distinct HWIDs, or from more
# than N distinct IPs, within the window. 0 = off. Only successful executions
# count, so a stranger cannot get someone else's key banned.
KEY_SHARE_MAX_HWIDS=0
KEY_SHARE_MAX_IPS=0
KEY_SHARE_WINDOW_MS=3600000

# Per-key throttle: max successful auths per key per window (0 = off).
KEY_RATE_MAX=0
KEY_RATE_WINDOW_MS=60000

# Longest HWID accepted. Anything longer is rejected, never truncated.
HWID_MAX_LENGTH=128

# ---- Discord bot (optional — leave empty to not run the bot) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_SCRIPT_ID=
DISCORD_WHITELIST_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_KEY_EXPIRES_DAYS=
