# 2t1auth API service
# Install:
#   sudo cp deploy/systemd/2t1auth.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now 2t1auth
# Logs:
#   journalctl -u 2t1auth -f

[Unit]
Description=2t1auth API
After=network.target

[Service]
Type=simple
User=2t1auth
Group=2t1auth
WorkingDirectory=/opt/2t1auth
# Resolved from PATH rather than pinned to /usr/bin/node, because npm resolves
# its own `node` the same way. On a host with a second Node (say /usr/local/bin
# from a manual install) a pinned path builds better-sqlite3 against one ABI and
# runs it under the other, and the service crash-loops on NODE_MODULE_VERSION.
ExecStart=/usr/bin/env node src/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# The app loads /opt/2t1auth/.env itself via dotenv.

# --- light hardening ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
